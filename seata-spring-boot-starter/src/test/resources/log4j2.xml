<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Seata 日志级别 - 使用正确的包名 -->
        <Logger name="org.apache.seata" level="error" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- Fury 日志级别 - 抑制警告 -->
        <Logger name="org.apache.fury" level="error" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Spring 日志级别 -->
        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- 测试包日志级别 -->
        <Logger name="simple_seata_demo_01" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>